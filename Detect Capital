class Solution {
    public boolean detectCapitalUse(String word) {
        if (word.length() <= 1) return true;

        boolean allUpper = Character.isUpperCase(word.charAt(1));

        for (int i = 2; i < word.length(); i++) {
            if (Character.isUpperCase(word.charAt(i)) != allUpper) {
                return false;
            }
        }

        return !allUpper || Character.isUpperCase(word.charAt(0));
    }
}
