class Solution {

    public int fib(int n) {
        int[] memo = new int[n + 1];

        for (int i = 0; i <= n; i++) {
            memo[i] = -1;
        }

        return fibonacci(n, memo);
    }

    public int fibonacci(int n, int[] memo) {
        if (n == 0 || n == 1) {
            return n;
        }

        if (memo[n] != -1) {
            return memo[n];
        }

        memo[n] = fibonacci(n - 1, memo) + fibonacci(n - 2, memo);

        return memo[n];
    }
}
