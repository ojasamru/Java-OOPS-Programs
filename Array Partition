class Solution {
    public int arrayPairSum(int[] nums) {
        Arrays.sort(nums);

        int sum = 0;

        for (int i = 0; i < nums.length; i += 2) {
            int first = nums[i];
            int second = nums[i + 1];

            if (first < second) {
                sum += first;
            } else {
                sum += second;
            }
        }

        return sum;
    }
}
